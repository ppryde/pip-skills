.venv/
__pycache__/
*.pyc
.workflow/
.vigil/
# Anywhere, not just the frontend's own: `plugins/overseer/dashboard/`
# grows a `node_modules/.vite` cache that a repo-wide `git add -A` will
# otherwise stage.
node_modules/

# RPG icon source library (17MB) — only the used subset is committed into the overseer dashboard bundle
/assets/rpg-icons/
/assets/rpg-icons-transparent/
# Per-repo overseer state. Directory-level: `config.local.json` and
# `remote-token` were listed individually, which left anything ELSE that landed
# here — a stray db, a cache, a future state file — untracked but unignored,
# and so eligible for `git add -A`. `config.json` is the only thing here
# intended to be shared, and it is not currently committed either.
.overseer/

# Databases, wherever they appear. The overseer board lives outside the repo
# (`~/.claude*/overseer/<repo>/board.db`) and the almoner's store is specified
# to do the same — but both hold work content at rest, and one landing in the
# tree is a matter of when rather than whether. A pattern costs nothing; the
# alternative is noticing in a diff.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# The Almoner's LOCAL demo digest — a developer's own inflow, gathered to see
# the page against real content. Never committed: this repo is public, and the
# shipped `fixture.ts` beside it is invented precisely so that it can ship.
# `demo.ts` prefers this file when it exists and falls back when it does not.
plugins/overseer/dashboard/frontend/src/board/almoner/fixture.local.ts

# Local-only working documents — incident notes, support tickets, anything
# holding real names, SHAs or customer data. Never committed. This repo is
# public (currently private pending a GitHub Support purge), and the lesson of
# 936e42d is that "I will remember not to commit it" is not a control.
/local/

# Untracked review / scratch artefacts produced inside the checkout: review-panel
# runs, scratch notes and dashboard logs can quote code, env and transcripts.
/.review-panel/
/scratch/
/scratchpad_*.log
