index 1c836fd..f1fe06f 100644
--- a/tests/integration/_waiting.py
+++ b/tests/integration/_waiting.py
@@ -9,10 +9,14 @@ MAX_POLLS = 40
 def wait_until_drained(outbox) -> None:
     """Block until `outbox` reports that it has drained.
 
-    Polls at POLL_INTERVAL and gives up after MAX_POLLS attempts.
+    Checks before sleeping, so an outbox that is already drained (the case
+    for every caller today, since `Outbox.drain()` is synchronous) returns
+    immediately instead of paying a guaranteed POLL_INTERVAL sleep. Still
+    polls at POLL_INTERVAL and gives up after MAX_POLLS attempts for a
+    backend where draining is genuinely asynchronous.
     """
     for _ in range(MAX_POLLS):
-        time.sleep(POLL_INTERVAL)
         if outbox.is_drained():
             return
+        time.sleep(POLL_INTERVAL)
     raise TimeoutError("outbox did not drain within the poll budget")
