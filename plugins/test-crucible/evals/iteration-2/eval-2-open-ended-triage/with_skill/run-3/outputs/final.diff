@@ -9,10 +9,14 @@ MAX_POLLS = 40
 def wait_until_drained(outbox) -> None:
     """Block until `outbox` reports that it has drained.
 
-    Polls at POLL_INTERVAL and gives up after MAX_POLLS attempts.
+    Checks before sleeping, so an outbox that is already drained (the
+    common case here -- every caller invokes this right after `drain()`)
+    returns immediately instead of paying a wasted poll interval. Still
+    polls at POLL_INTERVAL and gives up after MAX_POLLS attempts for a
+    genuinely pending outbox.
     """
     for _ in range(MAX_POLLS):
-        time.sleep(POLL_INTERVAL)
         if outbox.is_drained():
             return
+        time.sleep(POLL_INTERVAL)
     raise TimeoutError("outbox did not drain within the poll budget")
