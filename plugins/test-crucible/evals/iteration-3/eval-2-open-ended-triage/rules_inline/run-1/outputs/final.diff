@@ -9,10 +9,15 @@ MAX_POLLS = 40
 def wait_until_drained(outbox) -> None:
     """Block until `outbox` reports that it has drained.
 
-    Polls at POLL_INTERVAL and gives up after MAX_POLLS attempts.
+    Checks before each sleep, so an outbox that is already drained (true of
+    every caller here, since Outbox.drain() is synchronous) returns
+    immediately instead of paying a full POLL_INTERVAL for nothing. Retries
+    up to MAX_POLLS times, same total poll budget as before.
     """
     for _ in range(MAX_POLLS):
-        time.sleep(POLL_INTERVAL)
         if outbox.is_drained():
             return
+        time.sleep(POLL_INTERVAL)
+    if outbox.is_drained():
+        return
     raise TimeoutError("outbox did not drain within the poll budget")
