diff --git a/tests/integration/_waiting.py b/tests/integration/_waiting.py
index 1c836fd..21a5ec7 100644
--- a/tests/integration/_waiting.py
+++ b/tests/integration/_waiting.py
@@ -9,10 +9,15 @@ MAX_POLLS = 40
 def wait_until_drained(outbox) -> None:
     """Block until `outbox` reports that it has drained.
 
-    Polls at POLL_INTERVAL and gives up after MAX_POLLS attempts.
+    Checks first and only sleeps if the outbox is not yet drained, then polls
+    at POLL_INTERVAL and gives up after MAX_POLLS attempts. The old
+    sleep-then-check order paid one full POLL_INTERVAL on every call even
+    when the outbox -- a synchronous, in-memory fake -- was already drained
+    before wait_until_drained was ever invoked, which was true in every
+    caller in this suite.
     """
     for _ in range(MAX_POLLS):
-        time.sleep(POLL_INTERVAL)
         if outbox.is_drained():
             return
+        time.sleep(POLL_INTERVAL)
     raise TimeoutError("outbox did not drain within the poll budget")
